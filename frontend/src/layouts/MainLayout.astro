---
import HeaderUser from '../components/HeaderUser.jsx';
import GlobalLoader from '../components/GlobalLoader.jsx';
import NotificationToast from '../components/NotificationToast.jsx';
const { title } = Astro.props;
---

<html lang="es" class="dark">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Samurai Kallpa</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-kallpa-dark text-kallpa-text font-sans antialiased overflow-x-hidden min-h-screen">
    <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-gray-900 via-kallpa-dark to-black opacity-80 z-0"></div>
    <div class="relative z-10 flex flex-col min-h-screen">
        <header class="container mx-auto px-4 py-6 flex justify-between items-center absolute w-full z-50 top-0 left-0 right-0">
             <HeaderUser client:only="react" />
        </header>
        <slot />
    </div>
    <GlobalLoader client:only="react" />
    <NotificationToast client:only="react" />
    
    <style is:global>
        .clip-path-katana {
            clip-path: polygon(10% 0, 100% 0, 100% 80%, 90% 100%, 0 100%, 0 20%);
        }
    </style>
</body>
</html>
